{
  "name": "unity-urp-shader-intellisense",
  "displayName": "Unity URP Shader IntelliSense",
  "description": "Provides IntelliSense for Unity URP shaders",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:shaderlab",
    "onLanguage:hlsl",
    "onLanguage:compute"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "shaderlab",
        "aliases": [
          "ShaderLab",
          "Unity Shader"
        ],
        "extensions": [
          ".shader"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hlsl",
        "aliases": [
          "HLSL",
          "High Level Shading Language"
        ],
        "extensions": [
          ".hlsl"
        ]
      },
      {
        "id": "compute",
        "aliases": [
          "Unity Compute Shader",
          "Compute Shader"
        ],
        "extensions": [
          ".compute"
        ]
      }
    ],
    "commands": [
      {
        "command": "unityShaderIntellisense.reloadDatabase",
        "title": "Unity Shader IntelliSense: Reload Database"
      }
    ],
    "configuration": {
      "title": "Unity URP Shader IntelliSense",
      "properties": {
        "unityShaderIntellisense.databasePath": {
          "type": "string",
          "default": "Library/ShaderIntelliSense/shader-intellisense.json",
          "description": "Path to the generated Unity shader IntelliSense database."
        },
        "unityShaderIntellisense.autoGenerateDatabase": {
          "type": "boolean",
          "default": true,
          "description": "Automatically generate the shader database when the extension starts."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
