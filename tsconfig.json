{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": [
            "ES2022"
        ],
        "outDir": "out",
        "rootDir": ".",
        "strict": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "vscode"
        ]
    },
    "include": [
        "src/**/*.ts",
        "server/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "out",
        ".vscode-test"
    ]
}